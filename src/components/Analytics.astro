---
// Google Analytics 4. Se carga cuando se cumplen dos condiciones: que PUBLIC_GA_ID
// traiga un ID de medición con la forma correcta, y que sea un build de producción.
// Lo segundo importa tanto como lo primero: con el servidor de desarrollo midiendo,
// cada recarga en la máquina de quien programa entra como visita real y ensucia justo
// las cifras con las que cada quien va a reportar su tráfico. Para comprobar que
// Analytics quedó bien puesto, `npm run build && npm run preview`, que sirve el build
// de producción.
//
// Los parámetros propios (cápsula, serie, investigadores) viajan con la vista de
// página para poder desglosar el tráfico por contenido y por autor.
import { idMedicion, parametrosCapsula, type DatosCapsulaAnalytics } from '../lib/analytics';

interface Props {
  datos?: DatosCapsulaAnalytics;
}

const { datos = {} } = Astro.props;
const id = import.meta.env.PROD ? idMedicion(import.meta.env.PUBLIC_GA_ID) : '';
const params = parametrosCapsula(datos);
---

{id && (
	<>
		<script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${id}`}></script>
		<script is:inline define:vars={{ id, params }}>
			window.dataLayer = window.dataLayer || [];
			function gtag() { window.dataLayer.push(arguments); }
			window.gtag = gtag;
			gtag('js', new Date());
			gtag('config', id, params);
		</script>
	</>
)}
