---
// Armazón común de los recorridos de scrollytelling: escenario fijo, capa de
// imágenes, subtítulos flotantes, banda de mandos al pie (riel de avance a todo lo
// ancho, anterior/reproducir/siguiente, contador y botón de volver al inicio) y línea
// de créditos. Cada recorrido aporta solo su escena SVG (por el slot) y su
// configuración de cámara.
//
// El texto y las imágenes de los pasos vienen de src/content/recorridos/<id>.yaml,
// que es lo que corrigen los autores desde la ficha en Drive.
import { withBase } from '../lib/url';
import { indices, porIndice, type PasoRecorrido } from '../lib/recorrido';

interface Credito {
  autor: string;
  licencia: string;
  fuente: string;
  /** Qué material cubre ese crédito (ej. "figuras del artículo"). Opcional. */
  que?: string;
}

interface Props {
  pasos: PasoRecorrido[];
  /** Encuadre del grupo .camera por paso, indexado por clave visual. */
  camaras?: Record<string, string>;
  /** Pasos (por clave visual) en los que el mapa se atenúa para dejar leer un momento. */
  atenuar?: string[];
  /** Fondo del escenario. */
  fondo?: string;
  /** Color del panel de los subtítulos. */
  fondoCaption?: string;
  /** Base RGB del velo que oscurece las fotos, en formato "r,g,b". */
  velo?: string;
  /** Color de los enlaces de la línea de créditos. */
  colorEnlace?: string;
  /** Fondo de la banda de créditos que cierra el recorrido. */
  fondoCreditos?: string;
  /** Umbral de disparo de scrollama. */
  offset?: number;
  creditos: Credito[];
  notaCreditos: string;
}

const {
  pasos,
  camaras = {},
  atenuar = [],
  fondo = 'radial-gradient(120% 90% at 50% 38%, #173352 0%, #0c1a2b 55%, #050c15 100%)',
  fondoCaption = 'rgba(8, 20, 32, 0.78)',
  velo = '5, 14, 24',
  colorEnlace = '#6f93b0',
  fondoCreditos = '#0c1a2b',
  offset = 0.75,
  creditos,
  notaCreditos,
} = Astro.props;

// Las claves visuales se traducen a números de paso aquí, una sola vez. Si una clave
// no existe, el build falla con un mensaje claro en vez de desincronizar el relato.
const config = {
  camaras: porIndice(pasos, camaras),
  dim: indices(pasos, atenuar),
  offset,
};
const conImagen = pasos.map((p, i) => ({ ...p, i })).filter((p) => p.imagen);
---

<div class="scrolly-bloque" style={`--fondo: ${fondo}; --caption-bg: ${fondoCaption}; --velo: ${velo}; --enlace: ${colorEnlace}; --banda: ${fondoCreditos}`}>
<section class="scrolly" data-step="0" data-mode={pasos[0]?.tipo ?? 'svg'} data-config={JSON.stringify(config)}>
	<div class="scrolly-stage">
		<div class="media-bg" aria-hidden="true">
			{conImagen.map((p) => (
				<img
					class:list={['media', p.tipo, p.imagenLado]}
					data-media={p.i}
					data-credito={p.credito}
					src={withBase(p.imagen!)}
					alt=""
					loading={p.i === 0 ? 'eager' : 'lazy'}
				/>
			))}
			<div class="media-scrim"></div>
		</div>

		<p class="stage-credito"></p>

		<slot />

	</div>

	<div class="scrolly-steps">
		{pasos.map((p, i) => (
			<div class="step" data-step={i} data-pos={p.pos} data-tipo={p.tipo}>
				<p class="caption">{p.texto}</p>
			</div>
		))}
	</div>

</section>

<!-- La línea de créditos va FUERA de la sección: dentro, el escenario sticky la
     tapaba y la atribución de las licencias CC quedaba invisible. -->
<p class="foto-creditos">
	{notaCreditos}{' '}
	{creditos.map((c, i) => (
		<>
			{i > 0 && ' · '}
			<a href={c.fuente} target="_blank" rel="noopener">{c.autor}</a> ({c.licencia}{c.que ? `, ${c.que}` : ''})
		</>
	))}
</p>

<!-- Última parada del recorrido: la pone la página (ficha de quien firma el artículo
     y botones de compartir) y se monta aquí dentro para que quede dentro del alcance
     de los mandos, que se pegan al bloque entero. -->
<slot name="cierre" />

	<!-- Mandos del recorrido. Viven FUERA del escenario, porque dentro los subtítulos
	     les pasan por encima al desplazarse, y fuera de la sección de los pasos,
	     porque la tarjeta de cierre es una parada más del recorrido y los mandos
	     tienen que seguir ahí cuando se llega a ella.
	     Van los últimos del bloque a propósito: una caja pegada por abajo solo se mete
	     en pantalla tirando hacia arriba desde el sitio que ocupa en el flujo, así que
	     puesta al principio no se pegaba nunca. -->
	<div class="scrolly-chrome">
		<div class="scrolly-cine">
			<span class="barra" role="slider" tabindex="0" aria-label="Avance del recorrido"
				aria-valuemin="1" aria-valuemax={pasos.length} aria-valuenow="1"
				aria-valuetext={`Paso 1 de ${pasos.length}`}><span class="relleno"></span></span>

			<div class="scrolly-fila">
				<div class="scrolly-mandos" role="group" aria-label="Controles del recorrido">
					<button type="button" class="mando mando-anterior" title="Paso anterior" aria-label="Paso anterior" disabled>
						<svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M11.5 2.5 5 8l6.5 5.5z" /><rect x="3.5" y="2.5" width="1.6" height="11" /></svg>
					</button>
					<button type="button" class="mando mando-play" data-estado="play" aria-pressed="false"
						title="Reproducir" aria-label="Reproducir el recorrido">
						<svg class="icono icono-play" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M4.5 2.5 13 8l-8.5 5.5z" /></svg>
						<svg class="icono icono-pausa" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><rect x="4" y="2.5" width="3" height="11" /><rect x="9" y="2.5" width="3" height="11" /></svg>
					</button>
					<button type="button" class="mando mando-siguiente" title="Paso siguiente" aria-label="Paso siguiente">
						<svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M4.5 2.5 11 8l-6.5 5.5z" /><rect x="10.9" y="2.5" width="1.6" height="11" /></svg>
					</button>
				</div>

				<!-- El total lo reescribe el motor al arrancar: solo él sabe si la página
			     trae tarjeta de cierre, que cuenta como una parada más. -->
			<span class="conteo"><span class="actual">1</span> / <span class="total">{pasos.length}</span></span>

				<!-- Dos rótulos: en pantalla estrecha el largo no cabe junto a los mandos y
				     acababa montándose encima. El nombre accesible no cambia. -->
				<button type="button" class="scrolly-inicio" hidden aria-label="Volver al inicio del recorrido">
					<span aria-hidden="true">↑</span>
					<span class="rotulo-largo">Volver al inicio</span>
					<span class="rotulo-corto">Inicio</span>
				</button>
			</div>
		</div>
	</div>
</div>

<script>
	import { initScrolly } from '../scripts/scrolly';

	if (document.readyState !== 'loading') initScrolly();
	else document.addEventListener('DOMContentLoaded', initScrolly);
</script>

<style>
	/* La reserva del alto de la banda se declara en el bloque entero, no en la sección
	   de los pasos: la tarjeta de cierre vive fuera de esa sección y también tiene que
	   apartarse de los mandos. */
	.scrolly-bloque { --mandos-alto: 6rem; }
	.scrolly {
		--stage-top: 64px;
		position: relative;
		width: 100%;
	}
	.scrolly-stage {
		position: sticky;
		top: var(--stage-top);
		height: calc(100vh - var(--stage-top));
		width: 100%;
		background: var(--fondo);
		overflow: hidden;
	}

	/* Capa de imágenes: foto a sangre (cover) o figura del artículo (a un costado,
	   sin marco, para que su texto fino siga siendo legible). */
	.media-bg { position: absolute; inset: 0; z-index: 0; }
	.media { opacity: 0; transition: opacity 800ms ease; }
	.media.on { opacity: 1; }
	.media.foto { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
	.media.figura { position: absolute; top: 8%; height: 80%; width: min(52vw, 600px); object-fit: contain; }
	.media.figura.izq { left: 3%; }
	.media.figura.der { right: 3%; }
	.media-scrim {
		position: absolute; inset: 0; opacity: 0; transition: opacity 800ms ease;
		background: linear-gradient(180deg, rgba(var(--velo), 0.55) 0%, rgba(var(--velo), 0.22) 40%, rgba(var(--velo), 0.78) 100%);
	}
	.media-scrim.on { opacity: 1; }

	/* Crédito y licencia de la imagen activa, en la esquina del escenario. */
	.stage-credito {
		position: absolute; right: 0.65rem; bottom: calc(var(--mandos-alto) + 0.4rem); z-index: 4;
		max-width: min(72vw, 30rem);
		font-family: 'Roboto Flex', sans-serif; font-size: 0.72rem; line-height: 1.35;
		color: rgba(255,255,255,0.82); background: rgba(6,14,22,0.62);
		padding: 0.3rem 0.6rem; border-radius: 6px; text-align: right;
		backdrop-filter: blur(4px); -webkit-backdrop-filter: blur(4px);
		opacity: 0; transition: opacity 400ms ease; pointer-events: none;
	}
	.stage-credito.on { opacity: 1; }

	/* Franja de los mandos: mide cero, así que no ocupa sitio en la maqueta, y pinta
	   por encima de la capa de subtítulos, que es la razón de que viva aquí fuera y
	   no dentro del escenario.

	   Se pega al borde de ABAJO de la ventana, que es donde va la banda. Pegarla
	   arriba, como el escenario, dejaba la banda flotando una pantalla más abajo en
	   cuanto el recorrido terminaba: aparecía encima del texto que viene después.
	   Pegada abajo, se suelta justo cuando se acaba el recorrido, igual que él. */
	.scrolly-chrome {
		position: sticky;
		bottom: 0;
		height: 0;
		z-index: 6;
		pointer-events: none;
	}

	/* Los mandos van en una banda ancha al pie del escenario, como los de un video.
	   Se cuelga del borde de abajo de la franja, que es el mismo del escenario, así
	   que no hace falta escribir en ningún sitio cuánto mide la banda. */
	.scrolly-cine {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		padding: 1.5rem clamp(0.9rem, 3vw, 2.25rem) 0.85rem;
		/* Degradado en vez de banda sólida: el escenario se funde con los mandos en
		   vez de quedar cortado por una línea recta. */
		background: linear-gradient(180deg, rgba(6, 14, 22, 0) 0%, rgba(6, 14, 22, 0.55) 35%, rgba(6, 14, 22, 0.92) 100%);
		font-family: 'Roboto Flex', sans-serif;
		font-size: 0.78rem;
		color: rgba(255, 255, 255, 0.88);
		pointer-events: auto;
	}

	/* El riel de avance ocupa todo el ancho; debajo, los mandos y las salidas. */
	.scrolly-cine .barra {
		display: block; width: 100%; height: 5px; border-radius: 3px;
		background: rgba(255, 255, 255, 0.26); overflow: hidden; cursor: pointer;
	}
	.scrolly-cine .barra:hover { height: 7px; margin-block: -1px; }
	.scrolly-cine .barra:focus-visible { outline: 2px solid #e8843f; outline-offset: 3px; }
	.scrolly-cine .relleno {
		display: block; width: 0; height: 100%; border-radius: 3px;
		background: #e8843f; transition: width 450ms ease;
	}
	.scrolly-fila { display: flex; align-items: center; gap: 0.85rem; }
	.scrolly-cine .conteo { font-variant-numeric: tabular-nums; white-space: nowrap; }
	.scrolly-cine .actual { font-weight: 700; color: #ffffff; }

	/* Mandos del recorrido: anterior, reproducir/pausa, siguiente. Quien no quiera
	   usarlos sigue desplazando como siempre; mueven el scroll, no lo sustituyen. */
	.scrolly-mandos { display: flex; align-items: center; gap: 0.25rem; }
	.mando {
		display: inline-flex; align-items: center; justify-content: center;
		width: 2.1rem; height: 2.1rem; padding: 0; border: 0; border-radius: 50%;
		background: transparent; color: #ffffff; cursor: pointer;
		transition: background 200ms ease, opacity 200ms ease;
	}
	.mando svg { width: 0.95rem; height: 0.95rem; fill: currentColor; }
	.mando:hover:not(:disabled) { background: rgba(232,132,63,0.9); }
	.mando:focus-visible { outline: 2px solid #e8843f; outline-offset: 1px; }
	.mando:disabled { opacity: 0.35; cursor: default; }
	/* El de reproducir pesa más que sus vecinos: es el que invita a usar los mandos. */
	.mando-play { background: rgba(255,255,255,0.14); }
	.mando-play svg { width: 1.1rem; height: 1.1rem; }
	.mando-play .icono-pausa, .mando-play[data-estado='pausa'] .icono-play { display: none; }
	.mando-play[data-estado='pausa'] .icono-pausa { display: block; }

	/* Salida siempre a la vista: volver al principio del recorrido. Se va al extremo
	   derecho de la banda, lejos de los mandos, para no pulsarlo sin querer. */
	.scrolly-inicio {
		margin-left: auto;
		display: inline-flex; align-items: center; gap: 0.4rem;
		padding: 0.4rem 0.85rem; border-radius: 999px; cursor: pointer;
		border: 1px solid rgba(255,255,255,0.35); background: rgba(6,14,22,0.55);
		font-family: 'Roboto Flex', sans-serif; font-size: 0.78rem; font-weight: 500;
		color: #ffffff; transition: background 200ms ease, border-color 200ms ease;
	}
	.scrolly-inicio .rotulo-corto { display: none; }
	.scrolly-inicio:hover { background: rgba(196,86,32,0.85); border-color: #e8843f; }
	.scrolly-inicio:focus-visible { outline: 2px solid #e8843f; outline-offset: 2px; }
	.scrolly-inicio[hidden] { display: none; }

	/* Alto que la banda de mandos ocupa abajo. Lo reservan los pasos, el crédito de la
	   imagen y la tarjeta de cierre, para no quedar debajo de ella. Medido en el
	   navegador: 84 px en escritorio y 85 en teléfono, así que va con holgura. No se
	   calcula en marcha a propósito: cambiarlo con la página ya cargada cambiaría el
	   alto de los pasos, que es justo lo que descoloca el relato. Y es el mismo valor
	   para todos los modos, por lo mismo. */
	.scrolly-bloque { background: var(--banda); }
	.foto-creditos {
		max-width: 52rem; margin: 0 auto; padding: 1.75rem 1.5rem 1.5rem;
		font-size: 0.78rem; line-height: 1.5; color: rgba(255, 255, 255, 0.55); text-align: center;
	}
	.foto-creditos a { color: var(--enlace); text-decoration: none; }
	.foto-creditos a:hover { text-decoration: underline; }

	/* Subtítulos flotantes glass, no diapositivas. */
	.scrolly-steps { position: relative; z-index: 3; pointer-events: none; }
	.step {
		/* La caja entera mide min-height, relleno incluido. Sin esto, cualquier relleno
		   vertical le suma alto al paso, y un relleno que dependa del modo del escenario
		   mueve de sitio todos los pasos de abajo cada vez que el modo cambia. */
		box-sizing: border-box;
		min-height: 100vh; display: flex; align-items: center; justify-content: center;
		padding: 0 clamp(1rem, 6vw, 6rem);
		padding-bottom: var(--mandos-alto);
	}
	.step[data-pos='left'] { justify-content: flex-start; }
	.step[data-pos='right'] { justify-content: flex-end; }
	.step[data-pos='center'] { justify-content: center; }
	.step:first-child { min-height: 88vh; }
	.caption {
		/* `--alza` separa el subtítulo del borde SIN tocar la maqueta. Un margen o un
		   relleno aquí le sumarían alto al paso, y como el hueco depende del modo del
		   escenario, eso volvería a mover todo el relato en cada cambio de paso. Una
		   transformación no participa en el flujo, así que no puede hacerlo. */
		--alza: 0px;
		pointer-events: auto; max-width: 30rem; margin: 0; padding: 1.25rem 1.5rem;
		font-size: clamp(1.15rem, 1.7vw, 1.5rem); line-height: 1.5; font-weight: 500; color: #ffffff;
		background: var(--caption-bg); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
		border-left: 3px solid #e8843f; border-radius: 4px; opacity: 0.32;
		transform: translateY(calc(10px + var(--alza)));
		transition: opacity 350ms ease, transform 350ms ease;
	}
	.step.activo .caption { opacity: 1; transform: translateY(var(--alza)); }
	.step[data-pos='center'] .caption {
		max-width: 42rem; text-align: center; border-left: none; border-top: 3px solid #e8843f;
		border-radius: 6px; padding: 1.5rem 2rem; font-size: clamp(1.2rem, 2vw, 1.65rem);
		font-weight: 600; line-height: 1.4;
	}
	/* En pasos de gráfico centrado el subtítulo baja al tercio inferior para no pisarlo.
	   El hueco lo pone `--alza`, una transformación: ninguna regla que dependa del modo
	   del escenario puede tocar lo que mide una caja, ni la del paso ni la de su
	   subtítulo, porque el modo cambia con cada paso y desplazaría todo el relato. */
	.scrolly[data-mode='svg'] .step[data-pos='center'] { align-items: flex-end; }
	.scrolly[data-mode='svg'] .step[data-pos='center'] .caption { --alza: -2vh; }

	@media (max-width: 720px) {
		.scrolly-bloque { --mandos-alto: 6.25rem; }
		.step, .step[data-pos='left'], .step[data-pos='right'] {
			justify-content: center; align-items: flex-end;
			padding: 0 1rem;
			padding-bottom: calc(var(--mandos-alto) + 1.5vh);
		}
		.caption { max-width: none; }
		.media.figura, .media.figura.izq, .media.figura.der {
			left: 3%; right: 3%; width: auto; top: 2%; height: 40%;
		}
		.scrolly-cine { font-size: 0.72rem; padding: 1.25rem 0.9rem 0.8rem; gap: 0.45rem; }
		.scrolly-fila { gap: 0.5rem; }
		/* En el teléfono el mando crece en vez de encoger: con 28 px de diana se falla
		   el toque, y un botón que no responde al primer intento parece roto. */
		.mando { width: 2.5rem; height: 2.5rem; }
		.mando svg { width: 1rem; height: 1rem; }
		.mando-play svg { width: 1.15rem; height: 1.15rem; }
		.scrolly-inicio { font-size: 0.74rem; padding: 0.4rem 0.7rem; }
		.scrolly-inicio .rotulo-largo { display: none; }
		.scrolly-inicio .rotulo-corto { display: inline; }
	}

	/* Teléfonos estrechos: los mandos, el contador y el botón de salida comparten una
	   sola fila, así que se aprieta todo antes que dejar que se monten. */
	@media (max-width: 420px) {
		.scrolly-cine { padding-inline: 0.65rem; }
		.scrolly-fila { gap: 0.35rem; }
		.scrolly-mandos { gap: 0; }
		.scrolly-inicio { padding: 0.4rem 0.6rem; }
	}
</style>
