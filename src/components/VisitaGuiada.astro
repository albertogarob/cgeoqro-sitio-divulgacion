---
// Resaltado a distancia para la visita guiada.
//
// En la presentación, cada parada enseña una página de este sitio dentro de un iframe.
// El deck y el sitio viven en orígenes distintos, así que el deck no puede marcar nada
// aquí dentro por su cuenta: manda un mensaje y esto dibuja el contorno.
//
// Dos cautelas, porque es un oyente abierto a quien sea que meta el sitio en un marco:
// solo se enciende cuando la página está DENTRO de un iframe, y lo único que acepta es
// dibujar un contorno sobre lo que case con un selector. No mueve nada ni escribe nada
// más que eso. La validación del mensaje vive en src/lib/visita.ts, con sus pruebas.
---

<div id="visita-capa" aria-hidden="true"></div>

<style>
	#visita-capa {
		position: fixed;
		inset: 0;
		z-index: 2147483000;
		pointer-events: none;
	}
	/* Rojo vivo y no el naranja de la casa: proyectado, el naranja se confunde con
	   el propio acento del sitio y casi no se ve. Aquí el contorno tiene que gritar.
	   La caja se dibuja alrededor del elemento, con box-sizing de borde, para que el
	   filo de dentro del contorno coincida con el agujero de la penumbra. */
	#visita-capa :global(.visita-caja) {
		position: fixed;
		box-sizing: border-box;
		border: 4px solid #e60f0f;
		border-radius: 6px;
		box-shadow: 0 0 0 5px rgba(230, 15, 15, 0.3);
		transition: opacity 160ms ease;
	}
	/* La penumbra: una sola capa oscura con un agujero por cada cosa resaltada. Antes
	   era una sombra de 9999px por caja, y cada caja apagaba a las demás. */
	#visita-capa :global(.visita-penumbra) {
		position: fixed;
		inset: 0;
		background: rgba(8, 20, 32, 0.34);
	}
</style>

<script>
	import type { Hueco } from '../lib/visita';
	import { caminoDePenumbra, cuentaDeHuecos, hayQueAcercarse, peticionDeResaltado } from '../lib/visita';

	// Fuera de un iframe esto no pinta nada y no escucha nada.
	if (window.parent !== window) {
		const capa = document.getElementById('visita-capa');
		let selectorActivo = '';
		let cuadro: number | undefined;
		// Un navegador que no recorte por camino se queda sin penumbra, con los contornos
		// rojos a secas, en vez de quedarse con la pantalla entera a oscuras.
		const hayPenumbra = typeof CSS !== 'undefined' && CSS.supports('clip-path', 'path("M0 0")');
		const GROSOR = 4;

		function pintar() {
			cuadro = undefined;
			if (!capa) return;
			capa.replaceChildren();
			if (!selectorActivo) return;
			let nodos: Element[] = [];
			try {
				nodos = Array.from(document.querySelectorAll(selectorActivo));
			} catch {
				// Un selector inválido no es motivo para tirar nada: se deja sin marcar.
				return;
			}
			const cajas: HTMLDivElement[] = [];
			const huecos: Hueco[] = [];
			// Tope de cajas: un selector amplio no puede llenar la pantalla de marcos.
			for (const n of nodos.slice(0, 24)) {
				const r = n.getBoundingClientRect();
				if (r.width < 1 || r.height < 1) continue;
				if (r.bottom < 0 || r.top > window.innerHeight) continue;
				const caja = document.createElement('div');
				caja.className = 'visita-caja';
				caja.style.top = `${r.top - GROSOR}px`;
				caja.style.left = `${r.left - GROSOR}px`;
				caja.style.width = `${r.width + GROSOR * 2}px`;
				caja.style.height = `${r.height + GROSOR * 2}px`;
				cajas.push(caja);
				huecos.push({ top: r.top, left: r.left, width: r.width, height: r.height });
			}
			if (!cajas.length) return;
			// La penumbra va primero, para que los contornos se pinten encima de ella y
			// no se apaguen con el resto de la página.
			if (hayPenumbra) {
				const camino = caminoDePenumbra(huecos, window.innerWidth, window.innerHeight);
				if (cuentaDeHuecos(camino) > 0) {
					const sombra = document.createElement('div');
					sombra.className = 'visita-penumbra';
					sombra.style.clipPath = `path(evenodd, "${camino}")`;
					capa.appendChild(sombra);
				}
			}
			for (const caja of cajas) capa.appendChild(caja);
		}

		function repintar() {
			if (cuadro === undefined) cuadro = requestAnimationFrame(pintar);
		}

		window.addEventListener('message', (ev: MessageEvent) => {
			const pide = peticionDeResaltado(ev.data);
			if (!pide) return;
			// Repetir el mismo resaltado no vuelve a mover la página: el deck manda un
			// mensaje por cada aviso del guion, y varios pueden ser de la misma pieza.
			const cambia = pide.selector !== selectorActivo;
			selectorActivo = pide.selector;
			if (cambia && pide.acercar && selectorActivo) acercarse(selectorActivo);
			repintar();
		});

		/**
		 * Desplaza la página hasta lo resaltado, pero solo si no se está viendo ya.
		 * Sin esa condición, pasar de una pieza a otra movería la página aunque las
		 * dos estuvieran delante, y dentro del recorrido se pelearía con su motor.
		 */
		function acercarse(selector: string) {
			let objetivo: Element | null = null;
			try {
				objetivo = document.querySelector(selector);
			} catch {
				return;
			}
			if (!objetivo) return;
			const r = objetivo.getBoundingClientRect();
			if (!hayQueAcercarse(r, window.innerHeight)) return;
			objetivo.scrollIntoView({ block: 'center', behavior: 'smooth' });
		}

		// Las cajas van en posición fija, así que siguen a la página al desplazarse o
		// al cambiar de tamaño.
		window.addEventListener('scroll', repintar, { passive: true });
		window.addEventListener('resize', repintar);
	}
</script>
