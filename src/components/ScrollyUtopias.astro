---
// Escena del recorrido sobre el Programa Utopías en Iztapalapa (paper de Karol
// Yáñez Soria et al., Geopauta 2026, CC BY). Texto parafraseado; gráfico SVG propio,
// sin reproducir figuras del artículo. Ver política de derechos de autor en CLAUDE.md.
//
// El texto y las fotos de los pasos viven en src/content/recorridos/utopias.yaml
// (lo que corrigen los autores). Aquí solo está la escena visual y su coreografía.
//
// Fondos fotográficos de apertura/autoconstrucción/cierre: fotos ilustrativas con
// licencia libre (CC BY-SA / dominio público, vía Wikimedia Commons), NO figuras del
// paper ni fotos del propio programa. Créditos y licencia en public/scrolly/CREDITOS.json.
import { getEntry } from 'astro:content';
import ScrollyShell from './ScrollyShell.astro';
import { indiceVisual } from '../lib/recorrido';

const celdas = [
  { x: 460, y: 180 }, { x: 540, y: 180 },
  { x: 380, y: 260 }, { x: 460, y: 260 }, { x: 540, y: 260 }, { x: 620, y: 260 },
  { x: 340, y: 340 }, { x: 420, y: 340 }, { x: 500, y: 340 }, { x: 580, y: 340 }, { x: 660, y: 340 },
  { x: 460, y: 420 }, { x: 540, y: 420 },
];
const nodos = [
  { x: 460, y: 180 }, { x: 540, y: 180 }, { x: 380, y: 260 }, { x: 620, y: 260 },
  { x: 340, y: 340 }, { x: 500, y: 340 }, { x: 660, y: 340 }, { x: 460, y: 420 }, { x: 540, y: 420 },
];
const enlaces = [
  ['460,180', '380,260'], ['380,260', '340,340'], ['340,340', '500,340'],
  ['500,340', '660,340'], ['660,340', '620,260'], ['620,260', '540,180'],
  ['500,340', '540,420'], ['540,420', '460,420'], ['540,180', '460,180'],
];
const exteriores = [
  { x: 120, y: 150 }, { x: 880, y: 175 }, { x: 150, y: 560 }, { x: 855, y: 545 }, { x: 500, y: 645 },
];
// Arreglo de personas (1 de cada 5): 5 columnas x 4 filas = 20; 4 resaltadas.
const personas: { x: number; y: number; on: boolean }[] = [];
for (let r = 0; r < 4; r++) {
  for (let c = 0; c < 5; c++) {
    const idx = r * 5 + c;
    personas.push({ x: 370 + c * 72, y: 225 + r * 72, on: idx % 5 === 0 });
  }
}

// Momento "metodo": cinco pines de visita de campo y diecinueve burbujas de entrevista.
const pines = Array.from({ length: 5 }, (_, i) => ({ x: 580 + i * 80, y: 185, i }));
const burbujas = Array.from({ length: 19 }, (_, i) => ({
  x: 575 + (i % 5) * 80,
  y: 330 + Math.floor(i / 5) * 58,
  i,
}));

// Momento "dentro": las seis familias de equipamiento de una Utopía.
const salas = [
  { l: 'Deporte', f: 'cancha' }, { l: 'Cultura', f: 'escenario' }, { l: 'Huertos', f: 'planta' },
  { l: 'Agua', f: 'onda' }, { l: 'Cuidados', f: 'anillos' }, { l: 'Juego', f: 'bloques' },
].map((sala, i) => ({ ...sala, x: 560 + (i % 3) * 145, y: 210 + Math.floor(i / 3) * 155, i }));

// Momento "casas": las casas sociales, con las Siemprevivas destacada.
const casas = [
  { l: 'Día', x: 80, y: 240 }, { l: 'Diversidad', x: 230, y: 240 }, { l: 'Rehabilitar', x: 380, y: 240 },
  { l: 'Colibrí', x: 155, y: 410 }, { l: 'Siemprevivas', x: 305, y: 410, hi: true },
].map((c, i) => ({ ...c, i }));

// Momento "desafios": los tres pendientes que señalan las autoras.
const pendientes = [
  { l: 'Mantenimiento', x: 620 }, { l: 'Enlaces', x: 760 }, { l: 'Coordinación', x: 900 },
].map((d, i) => ({ ...d, i }));

const recorrido = await getEntry('recorridos', 'utopias');
if (!recorrido) throw new Error('Falta el recorrido src/content/recorridos/utopias.yaml');
const pasos = recorrido.data.pasos;
// Cada escena se engancha a su paso por nombre, no por número: así, insertar un paso
// nuevo en el recorrido no desincroniza los gráficos.
const v = (clave: string) => indiceVisual(pasos, clave);

// Encuadre de la cámara en los pasos que lo cambian; el resto se queda en el plano general.
const camaras = {
  autoconstruccion: 'translate(-330,-190) scale(1.62)',
  expansion: 'translate(140,98) scale(0.72)',
  cierre: 'translate(110,77) scale(0.78)',
};

// Atribución de las fotos de fondo (licencia libre, ilustrativas, no del paper).
const creditosFotos = [
  { autor: 'Gzzz', licencia: 'CC BY-SA 4.0', fuente: 'https://commons.wikimedia.org/wiki/File:Ecatepec_de_Morelos_(2).jpg' },
  { autor: 'Gzzz', licencia: 'CC BY-SA 4.0', fuente: 'https://commons.wikimedia.org/wiki/File:Ecatepec_de_Morelos_(3).jpg' },
  { autor: 'Rollcloud', licencia: 'dominio público', fuente: 'https://commons.wikimedia.org/wiki/File:Mty_Tianguis_01.jpg' },
];
const nota = 'Fotografías de fondo (ilustrativas, licencia libre, no son del artículo ni del programa), vía Wikimedia Commons:';
---

<ScrollyShell
	pasos={pasos}
	camaras={camaras}
	atenuar={['densidad', 'marginacion', 'metodo', 'dentro', 'casas', 'cuidados', 'inversion', 'desafios']}
	fondo="radial-gradient(120% 90% at 50% 38%, #173352 0%, #0c1a2b 55%, #050c15 100%)"
	fondoCaption="rgba(8, 18, 32, 0.72)"
	velo="5, 12, 21"
	fondoCreditos="#0c1a2b"
	colorEnlace="#7d97b6"
	creditos={creditosFotos}
	notaCreditos={nota}
>
	<svg viewBox="0 0 1000 700" class="mapa" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
		<defs>
			<filter id="scGlow" x="-80%" y="-80%" width="260%" height="260%">
				<feGaussianBlur stdDeviation="6" result="b" />
				<feMerge><feMergeNode in="b" /><feMergeNode in="SourceGraphic" /></feMerge>
			</filter>
		</defs>

		<!-- ELEMENTO PERSISTENTE: el mapa, movido por la "cámara" -->
		<g class="map">
			<g class="camera">
				<!-- Expansión a la ciudad -->
				<g class="layer" data-from={v('expansion')}>
					<ellipse cx="500" cy="340" rx="430" ry="330" fill="none"
						stroke="rgba(232,132,63,0.45)" stroke-width="2" stroke-dasharray="7 10" />
					{exteriores.map((e) => <circle cx={e.x} cy={e.y} r="8" fill="#e8843f" opacity="0.6" />)}
				</g>
				<!-- Celdas (13 distritos) -->
				<g class="layer" data-from={v('apertura')}>
					{celdas.map((c) => (
						<rect class="celda" x={c.x - 33} y={c.y - 33} width="66" height="66" rx="10"
							fill="rgba(255,255,255,0.035)" stroke="rgba(255,255,255,0.22)" stroke-width="1" />
					))}
				</g>
				<!-- Retícula "hecha a mano" (se dibuja) -->
				<g class="layer draw-grid" data-from={v('autoconstruccion')} stroke="rgba(255,255,255,0.3)" stroke-width="1.2">
					{celdas.map((c) => (
						<>
							<line class="dl" x1={c.x - 33} y1={c.y} x2={c.x + 33} y2={c.y} />
							<line class="dl" x1={c.x} y1={c.y - 33} x2={c.x} y2={c.y + 33} />
						</>
					))}
				</g>
				<!-- Red de cuidados (se dibuja) -->
				<g class="layer draw-net" data-from={v('red')} stroke="#e8843f" stroke-width="2.5" fill="none">
					{enlaces.map(([a, b]) => {
						const [x1, y1] = a.split(',');
						const [x2, y2] = b.split(',');
						return <line class="dl" x1={x1} y1={y1} x2={x2} y2={y2} />;
					})}
				</g>
				<!-- Utopías (nodos, encendido escalonado) -->
				<g class="layer nodos" data-from={v('utopias')} filter="url(#scGlow)">
					{nodos.map((nd, i) => (
						<circle class="nodo" style={`--i:${i}`} cx={nd.x} cy={nd.y} r="10" fill="#e8843f" />
					))}
				</g>
			</g>
		</g>

		<!-- MOMENTO: 1 de cada 5 (arreglo de personas) -->
		<g class="only" data-only={v('densidad')}>
			{personas.map((p) => (
				<circle class:list={['persona', { hi: p.on }]} cx={p.x} cy={p.y} r="15"
					fill={p.on ? '#e8843f' : 'rgba(255,255,255,0.16)'} />
			))}
			<text class="mom-big" x="330" y="600" text-anchor="middle">1 de cada 5</text>
			<text class="mom-sub" x="330" y="635" text-anchor="middle">habitantes de la Ciudad de México</text>
		</g>

		<!-- MOMENTO: barra de marginación -->
		<g class="only" data-only={v('marginacion')}>
			<rect x="270" y="300" width="460" height="46" rx="23" fill="rgba(255,255,255,0.12)" />
			<rect class="barra-fill" x="270" y="300" height="46" rx="23" fill="#c45620" />
			<text class="mom-big" x="500" y="250" text-anchor="middle">+50%</text>
			<text class="mom-sub" x="500" y="400" text-anchor="middle">vive en zonas de desarrollo social bajo o muy bajo</text>
		</g>

		<!-- MOMENTO: visitas -->
		<g class="only" data-only={v('utopias')}>
			<text class="mom-big" x="740" y="590" text-anchor="middle"><tspan class="count" data-to="8">0</tspan> millones</text>
			<text class="mom-sub" x="740" y="628" text-anchor="middle">de visitas entre 2022 y 2024</text>
		</g>

		<!-- MOMENTO: estadísticas de expansión a la ciudad -->
		<g class="only" data-only={v('expansion')}>
			<text class="mom-big" x="300" y="120" text-anchor="middle"><tspan class="count" data-to="20">0</tspan></text>
			<text class="mom-sub" x="300" y="152" text-anchor="middle">países han venido a conocerlas</text>
			<text class="mom-big" x="710" y="120" text-anchor="middle"><tspan class="count" data-to="100">0</tspan></text>
			<text class="mom-sub" x="710" y="152" text-anchor="middle">nuevas Utopías proyectadas a 2030</text>
		</g>

		<!-- MOMENTO: cómo se investigó (visitas y entrevistas) -->
		<g class="only en-derecha" data-only={v('metodo')}>
			{pines.map((p) => (
				<g class="pin" style={`--i:${p.i}`}>
					<path d={`M${p.x} ${p.y + 30} C ${p.x - 22} ${p.y - 2}, ${p.x - 18} ${p.y - 30}, ${p.x} ${p.y - 30} C ${p.x + 18} ${p.y - 30}, ${p.x + 22} ${p.y - 2}, ${p.x} ${p.y + 30} Z`}
						fill="#e8843f" opacity="0.9" />
					<circle cx={p.x} cy={p.y - 12} r="7" fill="#0c1a2b" />
				</g>
			))}
			<text x="740" y="278" text-anchor="middle" class="mom-sub">5 visitas de campo</text>
			{burbujas.map((b) => (
				<g class="burbuja" style={`--i:${b.i}`}>
					<rect x={b.x - 28} y={b.y - 18} width="56" height="36" rx="12"
						fill="rgba(232,132,63,0.2)" stroke="#e8843f" stroke-width="1.5" />
					<path d={`M${b.x - 10} ${b.y + 18} L${b.x - 2} ${b.y + 28} L${b.x + 2} ${b.y + 18} Z`} fill="#e8843f" opacity="0.6" />
				</g>
			))}
			<text x="740" y="580" text-anchor="middle" class="mom-sub">19 entrevistas, 2023 a 2025</text>
		</g>

		<!-- MOMENTO: qué hay dentro de una Utopía -->
		<g class="only en-derecha" data-only={v('dentro')}>
			{salas.map((s) => (
				<g class="sala" style={`--i:${s.i}`}>
					<rect x={s.x - 65} y={s.y - 60} width="130" height="130" rx="16"
						fill="rgba(255,255,255,0.05)" stroke="rgba(232,132,63,0.55)" stroke-width="1.5" />
					{s.f === 'cancha' && <><circle cx={s.x} cy={s.y - 12} r="24" fill="none" stroke="#e8843f" stroke-width="3" /><line x1={s.x - 24} y1={s.y - 12} x2={s.x + 24} y2={s.y - 12} stroke="#e8843f" stroke-width="3" /></>}
					{s.f === 'escenario' && <><polygon points={`${s.x},${s.y - 38} ${s.x + 26},${s.y + 8} ${s.x - 26},${s.y + 8}`} fill="none" stroke="#e8843f" stroke-width="3" /><line x1={s.x - 30} y1={s.y + 8} x2={s.x + 30} y2={s.y + 8} stroke="#e8843f" stroke-width="3" /></>}
					{s.f === 'planta' && <><path d={`M${s.x} ${s.y + 10} L${s.x} ${s.y - 30}`} stroke="#e8843f" stroke-width="3" /><path d={`M${s.x} ${s.y - 14} C ${s.x - 30} ${s.y - 20}, ${s.x - 26} ${s.y - 44}, ${s.x} ${s.y - 38}`} fill="none" stroke="#e8843f" stroke-width="3" /><path d={`M${s.x} ${s.y - 6} C ${s.x + 30} ${s.y - 12}, ${s.x + 26} ${s.y - 36}, ${s.x} ${s.y - 30}`} fill="none" stroke="#e8843f" stroke-width="3" /></>}
					{s.f === 'onda' && [0, 1, 2].map((k) => (
						<path d={`M${s.x - 30} ${s.y - 26 + k * 18} q 15 -12 30 0 q 15 12 30 0`} fill="none" stroke="#e8843f" stroke-width="3" />
					))}
					{s.f === 'anillos' && [14, 24, 34].map((r) => (
						<circle cx={s.x} cy={s.y - 12} r={r} fill="none" stroke="#e8843f" stroke-width="2.5" opacity={1 - r / 60} />
					))}
					{s.f === 'bloques' && [0, 1].map((r) => [0, 1].map((c) => (
						<rect x={s.x - 26 + c * 28} y={s.y - 34 + r * 28} width="22" height="22" rx="5" fill="none" stroke="#e8843f" stroke-width="2.5" />
					)))}
					<text x={s.x} y={s.y + 52} text-anchor="middle" class="sala-txt">{s.l}</text>
				</g>
			))}
		</g>

		<!-- MOMENTO: las casas sociales -->
		<g class="only en-izquierda" data-only={v('casas')}>
			{casas.map((c) => (
				<g class:list={['casita', { hi: c.hi }]} style={`--i:${c.i}`}>
					<polygon points={`${c.x},${c.y - 46} ${c.x + 68},${c.y - 6} ${c.x - 68},${c.y - 6}`} />
					<rect x={c.x - 58} y={c.y - 6} width="116" height="72" rx="8" />
					<text x={c.x} y={c.y + 38} text-anchor="middle" class="casita-txt">{c.l}</text>
				</g>
			))}
			<text x="300" y="560" text-anchor="middle" class="mom-sub">Espacios de cuidado dentro de cada Utopía</text>
		</g>

		<!-- MOMENTO: el cuidado cotidiano -->
		<g class="only en-izquierda" data-only={v('cuidados')}>
			<g class="icono" style="--i:0">
				<rect x="90" y="220" width="104" height="112" rx="12" fill="none" stroke="#e8843f" stroke-width="3" />
				<circle cx="142" cy="282" r="30" fill="none" stroke="#e8843f" stroke-width="3" />
				<circle cx="112" cy="242" r="5" fill="#e8843f" />
				<text x="142" y="368" text-anchor="middle" class="sala-txt">Lavar</text>
			</g>
			<g class="icono" style="--i:1">
				<rect x="240" y="252" width="112" height="76" rx="10" fill="none" stroke="#e8843f" stroke-width="3" />
				<line x1="228" y1="276" x2="240" y2="276" stroke="#e8843f" stroke-width="3" />
				<line x1="352" y1="276" x2="364" y2="276" stroke="#e8843f" stroke-width="3" />
				<path d="M268 238 q 10 -18 20 0 M308 238 q 10 -18 20 0" fill="none" stroke="#e8843f" stroke-width="3" />
				<text x="296" y="368" text-anchor="middle" class="sala-txt">Comer</text>
			</g>
			<g class="icono" style="--i:2">
				<path d="M400 332 v -52 q 50 -44 100 0 v 52" fill="none" stroke="#e8843f" stroke-width="3" />
				<line x1="388" y1="332" x2="512" y2="332" stroke="#e8843f" stroke-width="3" />
				<circle cx="450" cy="268" r="9" fill="#e8843f" />
				<text x="450" y="368" text-anchor="middle" class="sala-txt">Cuidar</text>
			</g>
			<g class="reloj">
				<circle cx="140" cy="470" r="38" fill="none" stroke="#e8843f" stroke-width="3" />
				<path d="M140 470 v -22 M140 470 h 16" stroke="#e8843f" stroke-width="3" stroke-linecap="round" />
				<path class="giro" d="M186 450 a 46 46 0 1 1 -14 -16" fill="none" stroke="#e8843f"
					stroke-width="2.5" stroke-dasharray="5 7" />
			</g>
			<text x="200" y="478" class="mom-sub">tiempo que regresa a quien cuida</text>
		</g>

		<!-- MOMENTO: la diferencia de escala en la inversión -->
		<g class="only en-derecha" data-only={v('inversion')}>
			<text x="560" y="250" class="bar-label">Programa barrial previo, por proyecto</text>
			<rect x="560" y="266" width="400" height="30" rx="8" fill="rgba(255,255,255,0.1)" />
			<rect class="inv-fill inv-antes" x="560" y="266" height="30" rx="8" fill="rgba(255,255,255,0.45)" />
			<text x="560" y="330" class="inv-cifra">80 mil dólares</text>
			<text x="560" y="410" class="bar-label">Cada Utopía, en construcción</text>
			<rect x="560" y="426" width="400" height="30" rx="8" fill="rgba(255,255,255,0.1)" />
			<rect class="inv-fill inv-utopia" x="560" y="426" height="30" rx="8" fill="#e8843f" />
			<text x="560" y="490" class="inv-cifra">5 millones de dólares</text>
		</g>

		<!-- MOMENTO: los pendientes que señalan las autoras -->
		<g class="only en-derecha" data-only={v('desafios')}>
			{pendientes.map((d) => (
				<g class="pendiente" style={`--i:${d.i}`}>
					<circle cx={d.x} cy="290" r="52" fill="none" stroke="#e8843f" stroke-width="2.5" stroke-dasharray="6 8" />
					<text x={d.x} y="312" text-anchor="middle" class="interrogante">?</text>
					<text x={d.x} y="392" text-anchor="middle" class="pendiente-txt">{d.l}</text>
				</g>
			))}
			<text x="760" y="470" text-anchor="middle" class="mom-sub">lo que falta por resolver</text>
		</g>

		<!-- MOMENTO final: tres claves, legibles sobre la foto de cierre -->
		<g class="only" data-only={v('cierre')} data-sobre-foto="si">
			<g class="clave" style="--i:0"><rect x="120" y="600" width="230" height="60" rx="30" /><text x="235" y="637" text-anchor="middle">Liderazgo feminista</text></g>
			<g class="clave" style="--i:1"><rect x="385" y="600" width="230" height="60" rx="30" /><text x="500" y="637" text-anchor="middle">Cuidado colectivo</text></g>
			<g class="clave" style="--i:2"><rect x="650" y="600" width="230" height="60" rx="30" /><text x="765" y="637" text-anchor="middle">Política pública</text></g>
		</g>
	</svg>
	<!-- La tarjeta de cierre la pone la página y pasa de largo hasta el armazón, que
	     es quien la coloca dentro del alcance de los mandos. -->
	<slot name="cierre" slot="cierre" />
</ScrollyShell>

<style>
	.mapa { position: relative; z-index: 1; width: 100%; height: 100%; display: block; }
	.camera {
		transform-origin: 0 0;
		transition: transform 1000ms cubic-bezier(0.45, 0.05, 0.2, 1);
	}
	.map { transition: opacity 500ms ease, filter 500ms ease; }
	.map.dim { opacity: 0.28; filter: saturate(0.5); }
	.map.hide { opacity: 0; }

	/* capas acumulativas */
	.layer { opacity: 0; transition: opacity 600ms ease; }
	.layer.on { opacity: 1; }

	/* nodos: encendido escalonado + pulso */
	.nodos .nodo {
		opacity: 0;
		transform: scale(0.2);
		transform-origin: center;
		transform-box: fill-box;
		transition: opacity 400ms ease, transform 400ms cubic-bezier(0.34, 1.56, 0.64, 1);
		transition-delay: calc(var(--i) * 90ms);
	}
	.nodos.on .nodo {
		opacity: 1;
		transform: scale(1);
		animation: pulso 2.4s ease-in-out infinite;
		animation-delay: calc(var(--i) * 90ms + 600ms);
	}
	@keyframes pulso {
		0%, 100% { filter: none; }
		50% { r: 12; }
	}

	/* trazos que se dibujan */
	.draw-grid .dl, .draw-net .dl {
		stroke-dasharray: 80;
		stroke-dashoffset: 80;
		transition: stroke-dashoffset 700ms ease;
	}
	.draw-grid.on .dl, .draw-net.on .dl { stroke-dashoffset: 0; }
	.draw-net .dl { transition-duration: 900ms; }

	/* momentos (overlays de un solo paso) */
	.only { opacity: 0; pointer-events: none; transition: opacity 500ms ease; }
	.only.on { opacity: 1; }
	.mom-big {
		font-family: 'Archivo Expanded', sans-serif;
		font-weight: 700;
		font-size: 64px;
		fill: #ffffff;
	}
	.mom-sub {
		font-family: 'Roboto Flex', sans-serif;
		font-size: 22px;
		fill: rgba(255, 255, 255, 0.8);
	}
	.count { font-variant-numeric: tabular-nums; }
	.persona {
		transition: fill 300ms ease, transform 400ms cubic-bezier(0.34, 1.56, 0.64, 1);
		transform-origin: center;
		transform-box: fill-box;
	}
	.only.on .persona.hi { animation: saltar 500ms ease both; }
	@keyframes saltar {
		0% { transform: scale(0.4); }
		60% { transform: scale(1.25); }
