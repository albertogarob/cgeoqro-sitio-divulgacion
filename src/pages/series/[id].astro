---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { withBase } from '../../lib/url';
import CapsulaCard from '../../components/CapsulaCard.astro';

export async function getStaticPaths() {
  const series = await getCollection('series');
  const capsulas = await getCollection('capsulas');
  return series.map((serie) => ({
    params: { id: serie.id },
    props: {
      serie,
      capsulas: capsulas
        .filter((c) => c.data.serie.id === serie.id && !c.id.startsWith('ejemplo'))
        .sort((a, b) => b.data.fechaPublicacion.valueOf() - a.data.fechaPublicacion.valueOf()),
    },
  }));
}

const { serie, capsulas } = Astro.props;
const { Content } = await render(serie);
const acento = serie.data.colorAcento ?? 'var(--cg-color-naranja-300)';
---

<Base title={serie.data.nombre}>
	{serie.data.imagenPortada && (
		<div slot="hero" class="serie-hero" style={`--acento: ${acento}`}>
			<img class="serie-hero-img" src={withBase(serie.data.imagenPortada)} alt="" />
			<div class="serie-hero-cont">
				<p class="serie-hero-back"><a href={withBase('/series/')}>← Todas las series</a></p>
				<h1>{serie.data.nombre}</h1>
				<p class="serie-hero-desc">{serie.data.descripcion}</p>
			</div>
			{serie.data.imagenCredito && <span class="serie-hero-credito">{serie.data.imagenCredito}</span>}
		</div>
	)}

	{!serie.data.imagenPortada && (
		<>
			<p><a href={withBase('/series/')}>← Todas las series</a></p>
			<h1>{serie.data.nombre}</h1>
			<p class="intro">{serie.data.descripcion}</p>
		</>
	)}

	<article><Content /></article>

	<h2>Cápsulas de esta serie</h2>
	{capsulas.length === 0 ? (
		<p>Aún no hay cápsulas publicadas en esta serie.</p>
	) : (
		<div class="cap-grid">
			{capsulas.map((c) => <CapsulaCard capsula={c} />)}
		</div>
	)}

	<style>
		.intro { color: var(--cg-color-gris-500); }
		.cap-grid {
			display: grid;
			grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
			gap: 1.5rem;
			margin-top: 1.25rem;
		}

		/* Hero banner de la serie (ancho completo) */
		.serie-hero {
			position: relative;
			width: 100%;
			min-height: clamp(240px, 36vh, 380px);
			display: flex;
			align-items: flex-end;
			overflow: hidden;
			background: #0b1c2b;
		}
		.serie-hero-img {
			position: absolute;
			inset: 0;
			width: 100%;
			height: 100%;
			object-fit: cover;
		}
		.serie-hero::after {
			content: '';
			position: absolute;
			inset: 0;
			background: linear-gradient(180deg, rgba(6, 14, 22, 0.25) 0%, rgba(6, 14, 22, 0.45) 45%, rgba(6, 14, 22, 0.9) 100%);
		}
		.serie-hero-cont {
			position: relative;
			z-index: 2;
			width: 100%;
			max-width: 70rem;
			margin: 0 auto;
			padding: 2rem clamp(1.25rem, 5vw, 3rem) 2.25rem;
			color: #fff;
		}
		.serie-hero-back a {
			color: rgba(255, 255, 255, 0.85);
			font-size: 0.9rem;
			text-decoration: none;
		}
		.serie-hero-back a:hover { color: #fff; }
		.serie-hero-cont h1 {
			margin: 0.6rem 0 0.5rem;
			color: #fff !important;
			font-size: clamp(2rem, 4.5vw, 3rem);
			line-height: 1.05;
			border-left: 5px solid var(--acento);
			padding-left: 0.85rem;
		}
		.serie-hero-desc {
			margin: 0;
			max-width: 44rem;
			font-size: clamp(1rem, 1.7vw, 1.2rem);
			line-height: 1.5;
			color: rgba(255, 255, 255, 0.92);
		}
		.serie-hero-credito {
			position: absolute;
			right: 0.8rem;
			bottom: 0.5rem;
			z-index: 2;
			font-size: 0.68rem;
			color: rgba(255, 255, 255, 0.55);
		}
	</style>
</Base>
