---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import CapsulaCard from '../../components/CapsulaCard.astro';

const capsulas = (await getCollection('capsulas'))
  .filter((c) => !c.id.startsWith('ejemplo'))
  .sort((a, b) => b.data.fechaPublicacion.valueOf() - a.data.fechaPublicacion.valueOf());
---

<Base title="Cápsulas de conocimiento">
	<span class="cg-eyebrow">Divulgación</span>
	<h1>Cápsulas de conocimiento</h1>
	<p class="intro">Unidades breves de divulgación, una por hallazgo o tema, disponibles en varios formatos.</p>

	<div class="cap-grid">
		{capsulas.map((c) => <CapsulaCard capsula={c} />)}
	</div>

	<style>
		.intro {
			max-width: 46rem;
			color: var(--cg-color-gris-500);
		}
		.cap-grid {
			display: grid;
			grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
			gap: 1.5rem;
			margin-top: 1.75rem;
		}
	</style>
</Base>
