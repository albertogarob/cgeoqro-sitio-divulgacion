---
import Base from '../../layouts/Base.astro';
import { getCollection, getEntry, render } from 'astro:content';
import { withBase } from '../../lib/url';
import ScrollyUtopias from '../../components/ScrollyUtopias.astro';
import ScrollySequias from '../../components/ScrollySequias.astro';
import ScrollyInundaciones from '../../components/ScrollyInundaciones.astro';
import CapsulaCard from '../../components/CapsulaCard.astro';
import CompartirCapsula from '../../components/CompartirCapsula.astro';
import ContactoCapsula from '../../components/ContactoCapsula.astro';
import AutorCapsula from '../../components/AutorCapsula.astro';

export async function getStaticPaths() {
  const capsulas = await getCollection('capsulas');
  return capsulas.map((capsula) => ({ params: { id: capsula.id }, props: { capsula } }));
}

// Componentes de scrollytelling disponibles, indexados por la clave `scrolly`.
const scrollyComponents: Record<string, any> = { utopias: ScrollyUtopias, sequias: ScrollySequias, inundaciones: ScrollyInundaciones };

const { capsula } = Astro.props;
const { Content } = await render(capsula);
const ScrollyComp = capsula.data.scrolly ? scrollyComponents[capsula.data.scrolly] : null;
const esVideo = Boolean(capsula.data.videoUrl) && !ScrollyComp;

const serie = await getEntry(capsula.data.serie);
const paper = await getEntry(capsula.data.paperFuente);
const investigadores = await Promise.all(capsula.data.investigadores.map((ref) => getEntry(ref)));

// Los créditos se repiten en varios layouts.
const creditos = {
  investigadores,
  paper,
  revisadoPor: capsula.data.revisadoPor,
  creditoProduccion: capsula.data.creditoProduccion,
};

// "Te podría interesar": otras cápsulas, priorizando la misma serie.
const todas = (await getCollection('capsulas'))
  .filter((c) => !c.id.startsWith('ejemplo') && c.id !== capsula.id)
  .sort((a, b) => b.data.fechaPublicacion.valueOf() - a.data.fechaPublicacion.valueOf());
const mismaSerie = todas.filter((c) => c.data.serie.id === capsula.data.serie.id);
const otras = todas.filter((c) => c.data.serie.id !== capsula.data.serie.id);
const relacionadas = [...mismaSerie, ...otras].slice(0, 3);

// URL canónica absoluta de la cápsula: la usan los botones de compartir y el mensaje
// prellenado del formulario de contacto, que tienen que apuntar a esta página desde
// fuera del sitio.
const urlCapsula = new URL(withBase(`/capsulas/${capsula.id}/`), Astro.site).toString();
const nombresInvestigadores = investigadores.filter(Boolean).map((inv) => inv.data.nombre);

// En un recorrido, la ficha del autor y los botones de compartir suben a la tarjeta
// de cierre, que es donde para la reproducción automática; en los demás formatos se
// quedan al pie de la página. Se pintan una sola vez: dos bloques de compartir en la
// misma página dejarían el segundo sin guion, porque solo se engancha al primero.
const cierreDelRecorrido = Boolean(ScrollyComp);
---

<Base
	title={capsula.data.titulo}
	bleed={Boolean(ScrollyComp) || esVideo}
	description={capsula.data.resumenCorto}
	imagen={capsula.data.imagenPortada}
	tipo="article"
	analytics={{
		capsula: capsula.id,
		serie: capsula.data.serie.id,
		investigadores: nombresInvestigadores,
	}}
>
	{ScrollyComp ? (
		<>
			<div class="cap-wrap cap-intro">
				<p><a href={withBase('/capsulas/')}>← Todas las cápsulas</a></p>
				<h1>{capsula.data.titulo}</h1>
				<p class="meta">
					{serie && <a href={withBase(`/series/${serie.id}/`)}>{serie.data.nombre}</a>}
					{' · Recorrido interactivo'}
				</p>
				<p class="resumen"><strong>{capsula.data.resumenCorto}</strong></p>
				<p class="scroll-hint">
					Desplázate para recorrer la historia ↓ o da clic en
					<button type="button" class="hint-play" aria-label="Reproducir el recorrido desde el principio">
						<svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M4.5 2.5 13 8l-8.5 5.5z" /></svg>
					</button>
				</p>
			</div>

			<ScrollyComp>
					{/* Última parada del recorrido, y una más de los mandos: desde el último
					    paso, "siguiente" y la reproducción automática llegan aquí, y el
					    contador la cuenta. Se monta dentro del recorrido (hueco "cierre")
					    para quedar bajo la banda de mandos, que si no desaparecería justo
					    al llegar. El motor la busca por `data-recorrido-cierre`: con otro
					    nombre, el recorrido se queda sin su última parada. Va como
					    comentario de Astro y no de HTML para que no viaje al navegador. */}
				<section class="cap-final" data-recorrido-cierre slot="cierre">
					<div class="cap-wrap">
						<h2 class="cap-final-kicker">Fin del recorrido</h2>

						<AutorCapsula investigadores={investigadores} tema="oscuro" />

						<CompartirCapsula
							url={urlCapsula}
							titulo={capsula.data.titulo}
							resumen={capsula.data.resumenCorto}
							capsulaId={capsula.id}
							tema="oscuro"
							titular="Compártelo"
							entradilla="Difundir esta cápsula ayuda a que la investigación de CentroGeo Querétaro llegue más lejos."
						/>

						<div class="cap-final-acciones">
							<button type="button" class="volver-recorrido">↑ Volver al inicio del recorrido</button>
							{serie && <a href={withBase(`/series/${serie.id}/`)}>Más de {serie.data.nombre}</a>}
							<a href={withBase('/capsulas/')}>Todas las cápsulas</a>
						</div>
					</div>
				</section>
			</ScrollyComp>

			<div class="cap-wrap cap-outro">
				<article><Content /></article>
				<section class="referencia">
					<h2>Referencia</h2>
					{creditos.paper && (
						<p>
							{creditos.paper.data.titulo}. {creditos.paper.data.editorial} ({creditos.paper.data.anioPublicacion}).
							{creditos.paper.data.doi && (
								<> <a href={`https://doi.org/${creditos.paper.data.doi}`} target="_blank" rel="noopener">https://doi.org/{creditos.paper.data.doi}</a></>
							)}
						</p>
					)}
					{creditos.creditoProduccion && <p class="ref-nota">{creditos.creditoProduccion}</p>}
				</section>
			</div>
		</>
	) : esVideo ? (
		<>
			<div class="cap-wrap cap-intro">
				<p><a href={withBase('/capsulas/')}>← Todas las cápsulas</a></p>
				<h1>{capsula.data.titulo}</h1>
				<p class="meta">
					{serie && <a href={withBase(`/series/${serie.id}/`)}>{serie.data.nombre}</a>}
					{' · Video'}
				</p>
				<p class="resumen"><strong>{capsula.data.resumenCorto}</strong></p>
			</div>

			<div class="cine">
				<div class="cine-inner">
					<div class="cine-video">
						<iframe
							src={capsula.data.videoUrl}
							allow="autoplay; fullscreen"
							allowfullscreen
							loading="lazy"
							title={`Video: ${capsula.data.titulo}`}
						></iframe>
					</div>
					<p class="cine-fallback">
						¿No carga el video? Puede deberse a permisos de Google Drive. {capsula.data.fuenteExternaUrl ? (
							<a href={capsula.data.fuenteExternaUrl} target="_blank" rel="noopener">Míralo en la fuente original</a>
						) : (
							<a href={capsula.data.videoUrl} target="_blank" rel="noopener">Ábrelo en una pestaña nueva</a>
						)}.
					</p>
				</div>
			</div>

			<div class="cap-wrap cap-outro">
				<article><Content /></article>
				<section class="referencia">
					<h2>Referencia</h2>
					{creditos.paper && (
						<p>
							{creditos.paper.data.titulo}. {creditos.paper.data.editorial} ({creditos.paper.data.anioPublicacion}).
							{creditos.paper.data.doi && (
								<> <a href={`https://doi.org/${creditos.paper.data.doi}`} target="_blank" rel="noopener">https://doi.org/{creditos.paper.data.doi}</a></>
							)}
						</p>
					)}
					{creditos.creditoProduccion && <p class="ref-nota">{creditos.creditoProduccion}</p>}
				</section>
			</div>
		</>
	) : (
		<>
			<p><a href={withBase('/capsulas/')}>← Todas las cápsulas</a></p>
			<h1>{capsula.data.titulo}</h1>
			<p class="meta">
				{serie && <a href={withBase(`/series/${serie.id}/`)}>{serie.data.nombre}</a>}
				{' · '}
				{capsula.data.formatos.join(', ')}
			</p>

			<p class="resumen"><strong>{capsula.data.resumenCorto}</strong></p>

			{capsula.data.audioUrl && (
				<p><a href={capsula.data.audioUrl} target="_blank" rel="noopener">Escuchar audio</a></p>
			)}

			<article>
				<Content />
			</article>

			<section class="referencia">
				<h2>Referencia</h2>
				{creditos.paper && (
					<p>
						{creditos.paper.data.titulo}. {creditos.paper.data.editorial} ({creditos.paper.data.anioPublicacion}).
						{creditos.paper.data.doi && (
							<> <a href={`https://doi.org/${creditos.paper.data.doi}`} target="_blank" rel="noopener">https://doi.org/{creditos.paper.data.doi}</a></>
						)}
					</p>
				)}
				{creditos.creditoProduccion && <p class="ref-nota">{creditos.creditoProduccion}</p>}
			</section>
		</>
	)}

	{capsula.data.imagenCredito && (
		<p class="portada-credito">{capsula.data.imagenCredito}</p>
	)}

	{!cierreDelRecorrido && (
		<>
			<CompartirCapsula
				url={urlCapsula}
				titulo={capsula.data.titulo}
				resumen={capsula.data.resumenCorto}
				capsulaId={capsula.id}
			/>
			<AutorCapsula investigadores={investigadores} />
		</>
	)}

	<ContactoCapsula
		tituloCapsula={capsula.data.titulo}
		url={urlCapsula}
		investigadores={nombresInvestigadores}
		capsulaId={capsula.id}
	/>

	{relacionadas.length > 0 && (
		<section class="relacionadas">
			<h2>Te podría interesar</h2>
			<div class="rel-grid">
				{relacionadas.map((c) => <CapsulaCard capsula={c} />)}
			</div>
		</section>
	)}

	<style>
		.portada-credito {
			max-width: 46rem;
			margin: 1.75rem auto 0;
			padding: 0 1.5rem;
			font-size: 0.75rem;
			color: #999;
			text-align: center;
		}

		.relacionadas {
			max-width: 64rem;
			margin: 1rem auto 0;
			padding: 2.5rem 1.5rem 3.5rem;
			border-top: 1px solid var(--cg-color-gris-300);
		}
		.relacionadas h2 {
			margin: 0 0 1.25rem 0;
		}
		.rel-grid {
			display: grid;
			grid-template-columns: repeat(auto-fill, minmax(15.5rem, 1fr));
			gap: 1.25rem;
		}
		/* Tarjeta de cierre del recorrido, y última parada de la reproducción: quién
		   firma el artículo, los botones de compartir y las salidas claras. */
		.cap-final {
			background: linear-gradient(180deg, #0c1a2b 0%, #101f30 100%);
			padding: 2.25rem 0 2.5rem;
			/* Es la última parada del recorrido y la banda de mandos sigue encima, así
			   que hay que dejarle su hueco o tapa las salidas del final. La medida la
			   declara el armazón del recorrido, que es quien sabe cuánto mide. */
			padding-bottom: calc(var(--mandos-alto, 0px) + 2.5rem);
		}
		/* Es un h2 por accesibilidad, pero se ve como el antetítulo que era: hay que
		   repetir familia, interlineado y espaciado para ganarle al estilo global. */
		.cap-final-kicker {
			margin: 0 0 1.1rem 0;
			font-family: 'Roboto Flex', sans-serif;
			font-size: 0.8rem;
			font-weight: 600;
			line-height: 1.3;
			letter-spacing: 0.08em;
			text-transform: uppercase;
			color: #e8843f;
		}
		.cap-final-acciones {
			display: flex;
			flex-wrap: wrap;
			gap: 0.7rem;
			margin-top: 1.5rem;
			padding-top: 1.5rem;
			border-top: 1px solid rgba(255, 255, 255, 0.14);
		}
		.cap-final-acciones a,
		.cap-final-acciones button {
			display: inline-flex;
			align-items: center;
			gap: 0.4rem;
			padding: 0.6rem 1.1rem;
			border-radius: 999px;
			border: 1px solid rgba(255, 255, 255, 0.28);
			background: rgba(255, 255, 255, 0.06);
			color: #ffffff;
			font-family: inherit;
			font-size: 0.92rem;
			font-weight: 500;
			text-decoration: none;
			cursor: pointer;
			transition: background 200ms ease, border-color 200ms ease;
		}
		.cap-final-acciones a:hover,
		.cap-final-acciones button:hover {
			background: rgba(196, 86, 32, 0.85);
			border-color: #e8843f;
		}
		.cap-final-acciones button {
			background: #c45620;
			border-color: #c45620;
		}

		.cap-wrap {
			max-width: 46rem;
			margin: 0 auto;
			padding: 0 1.5rem;
		}
		.cap-intro {
			padding-top: 2.5rem;
			padding-bottom: 2rem;
		}
		.cap-outro {
			padding-top: 2.5rem;
			padding-bottom: 3rem;
		}
		.scroll-hint {
			display: flex;
			align-items: center;
			gap: 0.45rem;
			flex-wrap: wrap;
			color: var(--cg-color-naranja-300);
			font-weight: 600;
			font-size: 0.95rem;
			margin-top: 1.5rem;
		}
		/* Atajo para quien prefiere que se lo cuenten: arranca el recorrido desde el
		   primer paso en vez de tener que desplazarse hasta encontrarlo. */
		.hint-play {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			width: 2rem;
			height: 2rem;
			padding: 0;
			border: 0;
			border-radius: 50%;
			background: var(--cg-color-naranja-300);
			color: var(--cg-color-blanco);
			cursor: pointer;
			transition: background 200ms ease, transform 200ms ease;
		}
		.hint-play svg {
			width: 0.85rem;
			height: 0.85rem;
			fill: currentColor;
			/* El triángulo pesa a la izquierda: sin este empujón se ve descentrado. */
			margin-left: 0.1rem;
		}
		.hint-play:hover {
			background: var(--cg-color-naranja-500);
			transform: scale(1.08);
		}
		.hint-play:focus-visible {
			outline: 2px solid var(--cg-color-naranja-300);
			outline-offset: 3px;
		}
		.meta {
			color: #666;
			font-size: 0.9rem;
		}
		.resumen {
			font-size: 1.1rem;
		}
		.referencia {
			margin-top: 2rem;
			padding-top: 1.5rem;
			border-top: 1px solid #eee;
			font-size: 0.9rem;
			color: #555;
		}
		.referencia h2 {
			font-size: 1rem;
			text-transform: uppercase;
			letter-spacing: 0.06em;
			color: var(--cg-color-gris-700) !important;
			margin: 0 0 0.6rem 0;
		}
		.referencia p {
			margin: 0;
			line-height: 1.5;
		}
		.ref-nota {
			margin-top: 0.6rem !important;
			font-style: italic;
			color: #777;
		}

		/* ── Modo cine para cápsulas de video (full-bleed) ── */
		.cine {
			background: radial-gradient(120% 100% at 50% 0%, #16181c 0%, #0a0a0b 70%);
			padding: clamp(1.5rem, 4vw, 3.5rem) 1rem;
		}
		.cine-inner {
			max-width: min(94vw, 1280px);
			margin: 0 auto;
		}
		.cine-video {
			position: relative;
			width: 100%;
			aspect-ratio: 16 / 9;
			border-radius: 12px;
			overflow: hidden;
			background: #000;
			box-shadow: 0 40px 90px -45px rgba(0, 0, 0, 0.9);
		}
		.cine-video iframe {
			position: absolute;
			inset: 0;
			width: 100%;
			height: 100%;
			border: 0;
		}
		.cine-fallback {
			text-align: center;
			color: rgba(255, 255, 255, 0.55);
			font-size: 0.85rem;
			margin: 1rem 0 0 0;
		}
		.cine-fallback a {
			color: var(--cg-color-naranja-300);
		}
	</style>

	<script>
		// Botón de la tarjeta de cierre: regresa al primer paso del recorrido. Comparte
		// el mismo salto que el botón flotante del escenario.
		import { irAlInicioDelRecorrido, reproducirRecorrido } from '../../scripts/scrolly';

		document.querySelector<HTMLButtonElement>('.volver-recorrido')
			?.addEventListener('click', irAlInicioDelRecorrido);

		// Botón de play de la entrada: baja al primer paso y arranca la reproducción,
		// para quien prefiere que el recorrido se cuente solo.
		document.querySelector<HTMLButtonElement>('.hint-play')
			?.addEventListener('click', reproducirRecorrido);
	</script>
</Base>
